generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionState {
  CREATED
  INVITED
  BOTH_JOINED
  CONSENT_PENDING
  CONSENTED
  SIDE_A_INTAKE
  SIDE_B_INTAKE
  READY_FOR_SYNTHESIS
  SYNTHESIS_COMPLETED
  READY_FOR_PROPOSAL
  PROPOSALS_GENERATED
  NEGOTIATION_IN_PROGRESS
  AGREEMENT_REACHED
  PROPOSAL_READY
  NEGOTIATION
  AGREEMENT
  PARTIAL_AGREEMENT
  DEADLOCK
  ABANDONED
}

enum ParticipantRole {
  PARTY_A
  PARTY_B
}

enum ParticipantIntakeState {
  NOT_STARTED
  IN_PROGRESS
  SUMMARY_PENDING_CONFIRMATION
  COMPLETED
}

enum IntakeField {
  FACTS
  INTERPRETATIONS
  INTERESTS
  CONSTRAINTS
  BOUNDARIES
  DESIRED_OUTCOME
  ACCEPTABLE_CONCESSIONS
  NON_NEGOTIABLES
}

enum ProposalVariantType {
  BALANCED
  A_LEANING
  B_LEANING
}

enum NegotiationActionType {
  ACCEPT
  REJECT
  SUGGEST_EDIT
  SELECT_PREFERRED
}

enum NegotiationRoundStatus {
  OPEN
  FINALIZED
}

enum NegotiationRoundOutcome {
  PENDING
  CONTINUE_WITH_NEW_VERSION
  CONFLICTING_EDITS
  AGREEMENT_REACHED
  PARTIAL_AGREEMENT
  DEADLOCK
  ABANDONED
}

enum TransportChannel {
  TELEGRAM
  HTTP
}

enum ProtocolEventOutcome {
  ACCEPTED
  NO_OP
  ERROR
}

enum SynthesisReactionType {
  CONFIRM
  CLARIFY
}

enum IssueReactionType {
  ACCEPT
  REJECT
  REQUEST_CHANGE
}

enum DraftAgreementResponseType {
  CONFIRM
  REQUEST_CHANGE
  REJECT
}

enum DraftAgreementOutcomeType {
  AGREEMENT
  PARTIAL_AGREEMENT
  DEADLOCK
}

model MediationSession {
  id                String                @id @default(cuid())
  state             SessionState
  inviteTokenHash   String                @unique
  inviteTokenExpiresAt DateTime
  problemTopic      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  participants      SessionParticipant[]
  summaries         MediationSummary[]
  problemSyntheses  ProblemSynthesisSnapshot[]
  synthesisReviews  SynthesisReviewSignal[]
  issueLoops        IssueResolutionLoop[]
  issueReactions    IssueResolutionReaction[]
  draftAgreements   DraftAgreement[]
  draftResponses    DraftAgreementResponse[]
  draftOutcomes     DraftAgreementOutcome[]
  proposalSets      ProposalSet[]
  negotiationRounds NegotiationRound[]
  protocolEvents    ProtocolEvent[]
}

model SessionParticipant {
  id                String          @id @default(cuid())
  sessionId         String
  role              ParticipantRole
  telegramUserId    String
  consentGrantedAt  DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  session           MediationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  intake            ParticipantIntake?
  synthesisReviews  SynthesisReviewSignal[]
  issueReactions    IssueResolutionReaction[]
  draftResponses    DraftAgreementResponse[]

  @@unique([sessionId, role])
  @@unique([sessionId, telegramUserId])
}

model IssueResolutionLoop {
  id                  String                  @id
  caseId              String
  version             Int
  synthesisVersion    Int
  issueTitle          String
  sideAPriority       String
  sideBPriority       String
  issueConstraintsJson Json
  optionsJson         Json
  optionTradeoffsJson Json
  createdAt           DateTime                @default(now())

  session             MediationSession        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reactions           IssueResolutionReaction[]

  @@unique([caseId, version])
  @@index([caseId])
}

model IssueResolutionReaction {
  id            String            @id
  caseId        String
  loopVersion   Int
  participantId String
  optionId      String
  reactionType  IssueReactionType
  changeRequest String?
  createdAt     DateTime          @default(now())

  session       MediationSession  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  participant   SessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  loop          IssueResolutionLoop @relation(fields: [caseId, loopVersion], references: [caseId, version], onDelete: Cascade)

  @@unique([caseId, loopVersion, participantId, optionId])
  @@index([caseId, loopVersion])
}

model DraftAgreement {
  id                String                  @id
  caseId            String
  version           Int
  loopVersion       Int
  sourceOptionId    String
  agreementTitle    String
  agreedActionsJson Json
  boundariesJson    Json
  conditionsJson    Json
  fallbackRule      String
  reviewPoint       String
  createdAt         DateTime                @default(now())

  session           MediationSession        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  responses         DraftAgreementResponse[]
  outcomes          DraftAgreementOutcome[]

  @@unique([caseId, version])
  @@index([caseId])
}

model DraftAgreementResponse {
  id            String                    @id
  caseId        String
  draftVersion  Int
  participantId String
  responseType  DraftAgreementResponseType
  changeRequest String?
  createdAt     DateTime                  @default(now())

  session       MediationSession          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  participant   SessionParticipant        @relation(fields: [participantId], references: [id], onDelete: Cascade)
  draft         DraftAgreement            @relation(fields: [caseId, draftVersion], references: [caseId, version], onDelete: Cascade)

  @@unique([caseId, draftVersion, participantId])
  @@index([caseId, draftVersion])
}

model DraftAgreementOutcome {
  id            String                  @id
  caseId        String
  draftVersion  Int
  outcome       DraftAgreementOutcomeType
  createdAt     DateTime                @default(now())

  session       MediationSession        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  draft         DraftAgreement          @relation(fields: [caseId, draftVersion], references: [caseId, version], onDelete: Cascade)

  @@unique([caseId, draftVersion])
  @@index([caseId])
}

model ProblemSynthesisSnapshot {
  id           String            @id
  caseId       String
  version      Int
  focus        String
  sharedPoints String
  divergence   String
  createdAt    DateTime          @default(now())

  session      MediationSession  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviews      SynthesisReviewSignal[]

  @@unique([caseId, version])
  @@index([caseId])
}

model SynthesisReviewSignal {
  id                String                 @id
  caseId            String
  participantId     String
  synthesisVersion  Int
  reactionType      SynthesisReactionType
  createdAt         DateTime               @default(now())

  session           MediationSession       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  participant       SessionParticipant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  synthesisSnapshot ProblemSynthesisSnapshot @relation(fields: [caseId, synthesisVersion], references: [caseId, version], onDelete: Cascade)

  @@unique([caseId, participantId, synthesisVersion])
  @@index([caseId, synthesisVersion])
}

model ParticipantIntake {
  id                    String                  @id
  sessionId             String
  participantId         String                  @unique
  state                 ParticipantIntakeState
  currentField          IntakeField?
  normalizedPositionJson Json?
  generatedSummary      String?
  summaryVersion        Int                     @default(0)
  version               Int                     @default(1)
  completedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  participant           SessionParticipant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  rawMessages           IntakeRawMessage[]
  assistantQuestions    IntakeAssistantQuestion[]
  fieldAnswers          IntakeFieldAnswer[]
  confirmedSummary      IntakeConfirmedSummary?

  @@index([sessionId])
}

model IntakeRawMessage {
  id             String          @id
  intakeId       String
  participantId  String
  field          IntakeField
  content        String
  createdAt      DateTime        @default(now())

  intake         ParticipantIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@index([intakeId, participantId])
}

model IntakeAssistantQuestion {
  id             String          @id
  intakeId       String
  participantId  String
  field          IntakeField
  content        String
  createdAt      DateTime        @default(now())

  intake         ParticipantIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@index([intakeId, participantId])
}

model IntakeFieldAnswer {
  id             String          @id @default(cuid())
  intakeId       String
  field          IntakeField
  rawValue       String
  normalizedValue String
  updatedAt      DateTime        @updatedAt

  intake         ParticipantIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@unique([intakeId, field])
}

model IntakeConfirmedSummary {
  id             String          @id @default(cuid())
  intakeId       String          @unique
  summaryText    String
  confirmedAt    DateTime        @default(now())

  intake         ParticipantIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
}

model MediationSummary {
  id                         String            @id
  caseId                     String
  version                    Int
  sharedGoalsJson            Json
  overlappingInterestsJson   Json
  conflictingPointsJson      Json
  constraintsMatrixJson      Json
  nonNegotiablesConflictsJson Json
  potentialAgreementZonesJson Json
  riskAreasJson              Json
  neutralRepresentationJson  Json
  createdAt                  DateTime          @default(now())

  session                    MediationSession  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, version])
  @@index([caseId])
}

model ProposalSet {
  id                       String            @id
  caseId                   String
  version                  Int
  mediationSummaryVersion  Int
  parentProposalSetVersion Int?
  derivedFromRoundNumber   Int?
  createdAt                DateTime          @default(now())

  session                  MediationSession  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  variants                 ProposalVariant[]

  @@unique([caseId, version])
  @@index([caseId])
}

model ProposalVariant {
  id             String             @id
  proposalSetId  String
  variantType    ProposalVariantType
  payloadJson    Json

  proposalSet    ProposalSet        @relation(fields: [proposalSetId], references: [id], onDelete: Cascade)

  @@unique([proposalSetId, variantType])
}

model NegotiationRound {
  id                   String                 @id
  caseId               String
  roundNumber          Int
  proposalSetVersion   Int
  participantActionsJson Json
  status               NegotiationRoundStatus @default(OPEN)
  outcome              NegotiationRoundOutcome @default(PENDING)
  nextProposalSetVersion Int?
  createdAt            DateTime               @default(now())
  finalizedAt          DateTime?

  session              MediationSession       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, roundNumber])
  @@index([caseId])
}

model IdempotencyRecord {
  key                String           @id
  channel            TransportChannel
  caseId             String?
  participantId      String?
  actionType         String
  payloadHash        String
  responseJson       Json
  createdAt          DateTime         @default(now())

  @@index([channel, caseId, participantId, actionType, payloadHash, createdAt])
}

model ProtocolEvent {
  id                 String             @id
  caseId             String?
  participantId      String?
  actionType         String
  idempotencyKey     String
  channel            TransportChannel
  outcome            ProtocolEventOutcome
  errorCode          String?
  sessionState       SessionState?
  proposalSetVersion Int?
  roundNumber        Int?
  createdAt          DateTime           @default(now())

  session            MediationSession?  @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([idempotencyKey])
}
