    "grammy": "^1.42.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@vitest/coverage-v8": "^1.6.0",
    "prisma": "^5.15.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "vite": "^5.2.12",
